generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Society {
  id          String       @id
  name        String
  password    String
  locked      Boolean      @default(false)
  submittedAt DateTime?
  preferences Preference[]
}

model Preference {
  id        Int     @id @default(autoincrement())
  societyId String
  society   Society @relation(fields: [societyId], references: [id])
  domainId  String
  rank      Int

  @@unique([societyId, rank])
  @@unique([societyId, domainId])
}
