# Environment configuration for BVEST
# Copy to .env.local and fill in values.

# ── Admin portal ──────────────────────────────────────────────────────────────
# Master password for the /admin/login console. REQUIRED — admin login fails
# without it. Choose something long and unique.
ADMIN_PASSWORD=change-me

# ── Database (optional for local dev) ─────────────────────────────────────────
# Local dev falls back to: file:./prisma/dev.db (better-sqlite3).
# For production (Neon), set a Postgres connection string:
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Session encryption ────────────────────────────────────────────────────────
# Used by iron-session (src/lib/session.ts). Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-32-byte-hex-secret

# ── Society credentials ───────────────────────────────────────────────────────
# Managed in prisma/seed.ts — run `npm run prisma:seed` to create them.